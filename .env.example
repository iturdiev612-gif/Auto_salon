# Copy this file to .env. Keep real secrets out of Git and browser code.
# Use a random secret of at least 32 characters in production. Do not commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
# Private first-admin setup code. Do not share or commit a real value.
ADMIN_BOOTSTRAP_SECRET=

# For Vercel, use an Upstash Redis REST database to persist cars, users, orders, and reviews.
TFA_STORE_URL=
TFA_STORE_TOKEN=

# Optional Google OAuth app. Add http://localhost:5173/api/oauth/google/callback as callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_OAUTH_ENABLED=false

# Optional GitHub OAuth app. Add http://localhost:5173/api/oauth/github/callback as callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_GITHUB_OAUTH_ENABLED=false
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5173/api/oauth/google/callback
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/oauth/github/callback

# Optional Cloudinary unsigned image upload preset (browser-side values are public).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional order notifications by Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional SMTP order email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ORDER_EMAIL=


# Password reset email: configure either SMTP above (including SMTP_FROM) or Resend.
RESEND_API_KEY=
MAIL_FROM=

# Public social profile URLs. Leave blank until the showroom has its own accounts.
VITE_SOCIAL_THREADS=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TELEGRAM=
VITE_SOCIAL_YOUTUBE_KG=
VITE_SOCIAL_YOUTUBE_RU=

# Public 2GIS Raster Tiles API key, restricted to your website domain.
VITE_2GIS_API_KEY=
# Alternative: iframe src from the free 2GIS Map Constructor.
VITE_2GIS_WIDGET_URL=
